---
import { getLangFromUrl, useTranslations, localizePath } from '../i18n/index';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const navLinks = [
  { href: localizePath('/', lang), label: t('nav.home') },
  { href: localizePath('/guider/', lang), label: t('nav.guides') },
];
const currentPath = Astro.url.pathname;
---
<a class="skip-link" href="#main-content">{t('a11y.skipToContent')}</a>
<nav aria-label={t('a11y.nav.label')}>
  <ul>
    {navLinks.map(({ href, label }) => (
      <li>
        <a href={href} aria-current={currentPath === href ? 'page' : undefined}>
          {label}
        </a>
      </li>
    ))}
  </ul>
</nav>
