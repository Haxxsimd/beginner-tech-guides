---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Comments from '../../components/Comments.astro';
import { formatDate } from '../../lib/formatDate';
import { getLangFromUrl, useTranslations } from '../../i18n/index';

export async function getStaticPaths() {
  const guides = await getCollection('guider', ({ data }) => data.draft !== true);
  return guides.map((guide) => ({
    params: { slug: guide.id },
    props: { guide },
  }));
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const { guide } = Astro.props;
const { Content } = await render(guide);
const { title, description, pubDate, category, readingTimeMinutes } = guide.data;
---
<BaseLayout title={`${title} — Teknikguider`} description={description}>
  <article>
    <header>
      <h1>{title}</h1>
      <p class="guide-meta">
        <span class="category">{category}</span>
        {' · '}
        <time datetime={pubDate.toISOString()}>
          {formatDate(pubDate)}
        </time>
        {readingTimeMinutes != null && ` · ${t('guide.readingTime', { minutes: readingTimeMinutes })}`}
      </p>
      <p class="lead">{description}</p>
    </header>
    <Content />
  </article>
  <Comments slug={guide.id} lang={lang} />
</BaseLayout>
