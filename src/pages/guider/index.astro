---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate } from '../../lib/formatDate';
import { getLangFromUrl, useTranslations } from '../../i18n/index';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const allGuides = await getCollection('guider', ({ data }) => data.draft !== true);
const sorted = allGuides.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<BaseLayout
  title="Guider — Teknikguider"
  description="Alla guider om datorteknik på svenska. Enkla förklaringar för alla."
>
  <h1>{t('guides.heading')}</h1>
  <p>{t('guides.intro')}</p>

  {sorted.length === 0 ? (
    <p>{t('guides.empty')}</p>
  ) : (
    <ul class="guide-list">
      {sorted.map((guide) => (
        <li class="guide-card">
          <a href={`/guider/${guide.id}/`}>
            <h2>{guide.data.title}</h2>
            <p class="guide-meta">
              <span class="category">{guide.data.category}</span>
              {' · '}
              <time datetime={guide.data.pubDate.toISOString()}>
                {formatDate(guide.data.pubDate)}
              </time>
              {guide.data.readingTimeMinutes != null && ` · ${t('guide.readingTime', { minutes: guide.data.readingTimeMinutes })}`}
            </p>
            <p>{guide.data.description}</p>
          </a>
        </li>
      ))}
    </ul>
  )}
</BaseLayout>
